# Gemma (OpenAI 호환) 엔드포인트
GEMMA_BASE_URL=http://mtvs2026.work/v1

# 사용할 모델 이름
GEMMA_MODEL=balanced-q4-k-m-mtp

# OpenAI 호환 API 키 (실제 키로 바꿔서 .env 에 넣으세요. 이 예시 파일에는 진짜 키를 두지 마세요.)
GEMMA_API_KEY=replace-with-your-api-key

# Gemma 호출 타임아웃(초) - 이 시간을 넘으면 504 오류
GEMMA_TIMEOUT_SECONDS=60

# 생성 온도 (낮을수록 일관적)
GEMMA_TEMPERATURE=0.1

# 생각(추론) 과정 사용 여부. 약속 추출은 단순 작업이라 기본은 꺼둡니다(false).
# 끄면 응답이 빠르고 토큰이 절약됩니다.
GEMMA_ENABLE_THINKING=false

# 로그 상세도 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
